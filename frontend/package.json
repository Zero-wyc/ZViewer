{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-live2d-face.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --experimental-strip-types --test \"src/modules/music/utils/__tests__/*.test.ts\" \"src/modules/screen-sharing/__tests__/*.test.ts\" \"src/modules/voice-chat/__tests__/*.test.ts\" \"src/modules/piik-voice/__tests__/*.test.ts\" \"src/modules/piik-share/__tests__/*.test.ts\" \"src/modules/bilibili/__tests__/*.test.ts\" \"src/modules/live2d/__tests__/*.test.ts\"",
    "test:playsvideo": "node --test scripts/test-playsvideo-audio-drop.mjs scripts/test-playsvideo-audio-only.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:dict": "node scripts/i18n-extract.mjs --dict-only",
    "i18n:plan": "node scripts/i18n-translate.mjs --plan --force",
    "i18n:build": "node scripts/i18n-translate.mjs --build",
    "i18n:check": "node scripts/i18n-extract.mjs --check && node scripts/i18n-translate.mjs --check",
    "prebuild": "node scripts/prepare-live2d-face.mjs",
    "postbuild": "node scripts/precompress-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@videojs/core": "^10.0.0-rc.4",
    "@videojs/dash-video": "10.0.0-rc.4",
    "@videojs/media": "10.0.0-rc.4",
    "artplayer": "^5.4.0",
    "clsx": "^2.1.1",
    "danmaku": "^2.0.9",
    "flv.js": "^1.6.2",
    "hls.js": "^1.6.16",
    "i18next": "^26.5.12",
    "lucide-react": "^1.23.0",
    "mediabunny": "file:vendor/mediabunny",
    "pixi.js": "^8.23.0",
    "playsvideo": "file:vendor/playsvideo",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^6.30.4",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "untitled-pixi-live2d-engine": "^1.4.0",
    "zustand": "^5.0.14"
  }
}
