# ========================
# 后端环境变量
# ========================

# 统一端口：前后端共用同一端口（默认 3333），由后端托管前端静态文件
PORT=3333

# 监听地址。:: 表示监听所有 IPv4/IPv6 地址（双栈）
HOST=::

# ========================
# 数据存储路径
# ========================
# 所有持久化数据统一存放在项目根目录的 config/ 文件夹下，
# 升级时仅需保留 config/ 目录即可保留全部数据（数据库、用户上传文件、头像等）。
#
# Docker 部署：config/ 目录通过 named volume 持久化，重启后数据不丢失。
# 物理机部署：直接保留项目根的 config/ 目录即可。
#
# 下方环境变量通常无需手动配置，留空时使用默认值（config/ 下的子目录）。

# 数据根目录（默认：<project-root>/config/）
# CONFIG_DIR=

# SQLite 数据库文件路径（默认：<CONFIG_DIR>/dev.sqlite）
# 新机器首次启动前先执行一次 `npm run db:init` 建表并创建初始管理员。
# DATABASE_URL=/app/config/dev.sqlite

# 日志模式。默认开启 WAL：读不被写阻塞、崩溃恢复只需重放 -wal；
# 代价是会多出 dev.sqlite-wal / dev.sqlite-shm 两个旁文件，
# 备份请用 `npm run db:backup`（内部 VACUUM INTO），不要直接复制 .sqlite。
# 需要退回旧模式时设为 0。
# SQLITE_WAL=1

# 用户上传文件根目录（默认：<CONFIG_DIR>/uploads/）
# UPLOADS_DIR=

# 用户头像存储目录（默认：<CONFIG_DIR>/uploads/avatars/）
# AVATARS_DIR=

# 推流预留目录（默认：<CONFIG_DIR>/media/）。当前推流是内存转封装、不写文件，
# 保留这个配置只为兼容旧部署，留空即可。
# MEDIA_DIR=

# ========================
# 推流（OBS）与一起听（网易云）
# ========================
# OBS 推流：RTMP 收流 + HTTP-FLV 分发由后端**进程内**提供（internal/nms），
# 默认无需任何配置。源码运行 / 单容器 / 桌面壳都自带，不需要外部媒体服务。
# RTMP_PORT=3334            # OBS 里推流地址的端口
# HTTP_FLV_PORT=3335        # 进程内 HTTP-FLV 上游，只经 3333 的 /live 反代访问
# NMS_BIND=                 # RTMP 监听地址（默认 0.0.0.0）；内嵌 HTTP-FLV 只监听回环
# SERVER_HOST=push.example.com # 独立 RTMP 对外主机（不含端口）；优先于 HTTP 请求域名
# TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128 # 仅这些直接上游可用 X-Forwarded-Host 推导 OBS 主机
# HTTP 隧道不自动提供 RTMP TCP 通道；推流端口需有独立可达入口。
# 想改用外部媒体服务（SRS / node-media-server / 自建集群）时填它的 HTTP-FLV 地址，
# 此时不再监听本地 RTMP/FLV 端口，可用性改为 TCP 探测：
# NMS_HTTP_FLV_URL=http://127.0.0.1:3335
# 不内嵌但也不填 URL（纯调试外部服务用）：
# NMS_EMBEDDED=0
# 推流总开关（0 = 关闭，前端显示「推流服务不可用」）
# STREAM_PUSH_ENABLED=1

# 一起听用的网易云音乐 API：**外部服务**，本仓库不含网易云协议实现，
# 只把 /api/music/ncm/* 转发过去。默认值指向本机 36530；
# docker compose 用 `--profile music` 启动 ncm 服务时会覆盖成 http://ncm:3000。
# 服务不可达时音乐相关接口返回 503 NCM_UNAVAILABLE，其它功能不受影响。
# NCM_API_BASE=http://127.0.0.1:36530

# ========================
# 第三方媒体源配置（可选）
# ========================

# Emby / Jellyfin 客户端标识名（发送在 X-Emby-Authorization 请求头中）。
# 默认 ZViewer；部分私有服务器会限制客户端名，此时可改成 Emby Web / SenPlayer 之类。
# 空值或纯空格会回落到默认值，双引号与换行会被自动去掉。
# EMBY_CLIENT_NAME=ZViewer

# CORS 允许来源
# 开发环境可设置为 *；生产环境建议设置为前端域名，如 https://your-domain.com
# 多个来源用逗号分隔，如 https://a.com,https://b.com
# 设置为 false 表示不允许跨域
CORS_ORIGIN=*

# JWT 密钥（生产环境必须设置为强随机字符串，请勿使用默认 dev secret）
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Token 过期时间
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# 前端构建参数
# ========================

# 前端 API / Socket.IO 基础地址。
# 统一端口后建议留空，让前端使用 window.location.origin（由后端托管前端静态文件）
# 本地开发时指向后端地址：http://localhost:3333
VITE_API_URL=

# OBS 推流模式 HTTP-FLV 拉流基础地址（可选）。
# 统一端口后保持留空即可，前端默认使用相对路径 /live，由后端反向代理到 NMS 的 HTTP-FLV 端口（默认 3335）。
# 若使用独立子域名（如 https://flv.example.com）或不同路径，请显式设置：
# VITE_FLV_BASE_URL=https://your-domain.com/live
VITE_FLV_BASE_URL=

# ========================
# OBS 推流服务端口
# ========================

# RTMP 推流端口（OBS 连接），默认 3334
# RTMP_PORT=3334

# HTTP-FLV 拉流端口（Node Media Server 内部使用），默认 3335
# 统一端口后由后端 /live 路径反向代理到此端口，无需直接暴露
# HTTP_FLV_PORT=3335

# 资源合同：观众通过 GET /api/stream-push/watch/{roomId} 领取独立观看票据，
# /live 需转发到本后端的鉴权入口。发布码为 8 位；旧 32 位码需房主重新下载 OBS 配置。
# 外置 NMS 的直接 RTMP/HTTP 端口须在外置服务配置发布鉴权及网络访问控制。
