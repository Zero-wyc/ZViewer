# ========================
# 后端环境变量
# ========================

# 统一端口：前后端共用同一端口（默认 3333），由后端托管前端静态文件
PORT=3333

# 监听地址。:: 表示监听所有 IPv4/IPv6 地址（双栈）
HOST=::

# 运行环境：development / production
NODE_ENV=production

# ========================
# 数据存储路径
# ========================
# 所有持久化数据统一存放在项目根目录的 config/ 文件夹下，
# 升级时仅需保留 config/ 目录即可保留全部数据（数据库、用户上传文件、头像等）。
#
# Docker 部署：config/ 目录通过 named volume 持久化，重启后数据不丢失。
# 物理机部署：直接保留项目根的 config/ 目录即可。
#
# 下方环境变量通常无需手动配置，留空时使用默认值（config/ 下的子目录）。

# 数据根目录（默认：<project-root>/config/）
# CONFIG_DIR=

# SQLite 数据库文件路径（默认：<CONFIG_DIR>/dev.sqlite）
# DATABASE_URL=/app/config/dev.sqlite

# 用户上传文件根目录（默认：<CONFIG_DIR>/uploads/）
# UPLOADS_DIR=

# 用户头像存储目录（默认：<CONFIG_DIR>/uploads/avatars/）
# AVATARS_DIR=

# NMS 推流媒体临时目录（默认：<CONFIG_DIR>/media/）
# MEDIA_DIR=

# CORS 允许来源
# 开发环境可设置为 *；生产环境建议设置为前端域名，如 https://your-domain.com
# 多个来源用逗号分隔，如 https://a.com,https://b.com
# 设置为 false 表示不允许跨域
CORS_ORIGIN=*

# JWT 密钥（生产环境必须设置为强随机字符串，请勿使用默认 dev secret）
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Token 过期时间
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# 前端构建参数
# ========================

# 前端 API / Socket.IO 基础地址。
# 统一端口后建议留空，让前端使用 window.location.origin（由后端托管前端静态文件）
# 本地开发时指向后端地址：http://localhost:3333
VITE_API_URL=

# OBS 推流模式 HTTP-FLV 拉流基础地址（可选）。
# 统一端口后保持留空即可，前端默认使用相对路径 /live，由后端反向代理到 NMS 的 HTTP-FLV 端口（默认 3335）。
# 若使用独立子域名（如 https://flv.example.com）或不同路径，请显式设置：
# VITE_FLV_BASE_URL=https://your-domain.com/live
VITE_FLV_BASE_URL=

# ========================
# OBS 推流服务端口
# ========================

# RTMP 推流端口（OBS 连接），默认 3334
# RTMP_PORT=3334

# HTTP-FLV 拉流端口（Node Media Server 内部使用），默认 3335
# 统一端口后由后端 /live 路径反向代理到此端口，无需直接暴露
# HTTP_FLV_PORT=3335

# ========================
# PostgreSQL 配置（可选）
# ========================

# 如需使用 PostgreSQL，请同时修改后端 data-source.ts 中的数据库配置。
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change_me
# POSTGRES_DB=zviewer
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://postgres:change_me@db:5432/zviewer

# ========================
# 第三方媒体源配置（可选）
# ========================

# Emby / Jellyfin 客户端标识名（发送在 X-Emby-Authorization 请求头中）。
# 默认为 ZViewer；若服务器限制了客户端名称，可按需修改（如伪装成官方客户端或浏览器）。
# EMBY_CLIENT_NAME=ZViewer

