# Debian 12 bookworm（bullseye 已于 2026-08 结束 LTS，安全仓库包被清移 →
# apt 404 构建失败；产物为预编译 node26 二进制 + 静态文件，新版 glibc 向后兼容）
# procps: 提供 pgrep，供 Docker 更新脚本在 pidfile 缺失时回退定位后端进程
# xz-utils: 提供 xz 解压支持，tar -xf *.tar.xz 需要 xz 命令
# apt 重试：deb.debian.org 的 Fastly CDN 各节点索引与包池可能短暂不一致
# （索引里有旧版包但池里已更新 → 404），失败后重刷索引再试，最多 3 次
FROM debian:bookworm-slim
RUN apt-get update \
    && ok=0; for i in 1 2 3; do \
         if apt-get install -y --no-install-recommends \
              ca-certificates \
              procps \
              xz-utils; then ok=1; break; fi; \
         sleep 5; \
         apt-get update; \
       done; [ "$ok" = "1" ] \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制单文件产物（统一端口：后端托管前端静态文件，无需前端 exe）
# 语音聊天：LiveKit 伴生二进制直接打入镜像，容器启动时由 Go 后端的
# internal/livekit 自动拉起——单容器即含完整语音能力。
# OBS 推流：RTMP 收流 + HTTP-FLV 分发由 Go 后端**进程内**提供
# （internal/nms，3334 / 3335），不需要额外容器，也不需要外部媒体服务。
# 注意：二进制来自 build-all.js 产物（CI 下缺失会硬失败），直接 docker
# build 前需先跑 node build-all.js --linux
COPY dist/linux/zviewer-backend .
COPY dist/linux/livekit-server .
COPY dist/linux/start.sh .
COPY dist/linux/.env .
COPY dist/linux/package.json .
COPY dist/linux/frontend/dist ./frontend/dist/

# 创建运行时数据目录
RUN mkdir -p config/ssl config/uploads config/media log \
    && chmod +x zviewer-backend livekit-server start.sh

# 暴露端口
# 3333/tcp: 统一端口 - 后端 REST API + WebSocket (Socket.IO) + 前端静态文件 + /live HTTP-FLV 代理
# 3333/udp: LiveKit WebRTC 媒体传输（与页面同号不同协议）
# 3334/tcp: RTMP 推流端口 (OBS 连接，由后端进程内监听)
# 3337/tcp: 语音 ICE/TCP 直连（管理端「语音传输模式=TCP」时启用）
# 3338/tcp: 语音 TURN/TLS 中继（配齐 LIVEKIT_TURN_* 三项才启用，可与 3337 并存）
# 3335/tcp 是后端进程内的 HTTP-FLV 上游，只经 3333 的 /live 反代访问，不对外暴露。
EXPOSE 3333/tcp 3333/udp 3334/tcp 3337/tcp 3338/tcp

# Entrypoint（HTTP 模式，仅启动后端，由后端统一提供 API + 前端静态文件）
COPY docker/entrypoint-linux-single.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

CMD ["/app/entrypoint.sh"]
