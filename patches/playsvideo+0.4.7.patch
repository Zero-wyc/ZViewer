+        if (colonIndex === -1) return text;
+        const afterColon = text.substring(colonIndex + 1);
+        const parts = afterColon.split(',');
+        if (parts.length >= 10) {
+            return parts.slice(9).join(',');
+        }
+    }
+    const parts = text.split(',');
