{
  "name": "zviewer-desktop-console",
  "version": "0.4.1",
  "private": true,
  "description": "ZViewer Windows desktop console（Go + 系统 WebView2 原生壳）",
  "scripts": {
    "preview": "node preview-server.cjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.cjs",
    "shell:build": "node scripts/build-shell.mjs",
    "shell:dist": "node scripts/build-dist.mjs",
    "components:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-components.ps1",
    "package": "python scripts/package-release.py"
  }
}
