{
  "name": "zviewer",
  "version": "1.0.0",
  "private": true,
  "description": "ZViewer —— 基于浏览器的在线观影与屏幕共享平台。",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --kill-others",
    "dev:backend": "node scripts/dev-backend.js",
    "dev:backend:once": "node scripts/dev-backend.js --no-watch",
    "dev:frontend": "npm run dev -w frontend",
    "db:init": "cd backend-go && go run ./cmd/zviewer-server --init-db",
    "db:backup": "cd backend-go && go run ./cmd/zviewer-server --backup-db",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "node scripts/build-backend.js",
    "lint": "npm run lint:frontend",
    "lint:frontend": "npm run lint -w frontend",
    "lint:go": "cd backend-go && gofmt -l . && go vet ./...",
    "test:go": "cd backend-go && go test ./...",
    "test:regression": "bash backend-go/scripts/regression-sweep.sh",
    "test:media": "node --experimental-strip-types --test scripts/media-regression.test.mjs",
    "test:music": "node --experimental-vm-modules --test scripts/music-regression.test.mjs scripts/bilibili-parts.test.mjs scripts/music-toolbar.test.mjs scripts/music-quality.test.mjs",
    "start": "node scripts/start.js",
    "release:pull": "node scripts/pull-github-release.mjs",
    "build:exe": "node scripts/build-exe.js",
    "build:all": "node build-all.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^8.2.2"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zero-wyc/ZViewer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zero-wyc/ZViewer/issues"
  },
  "homepage": "https://github.com/Zero-wyc/ZViewer#readme",
  "overrides": {
    "mediabunny": "file:frontend/vendor/mediabunny"
  }
}
