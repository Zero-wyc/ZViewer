{
  "name": "zviewer",
  "version": "1.0.0",
  "private": true,
  "description": "ZViewer —— 基于浏览器的在线观影与屏幕共享平台。",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --kill-others",
    "dev:backend": "cd backend-go && go run ./cmd/zviewer-server",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build:frontend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "node scripts/build-backend.js",
    "lint": "npm run lint:frontend",
    "lint:frontend": "npm run lint -w frontend",
    "lint:go": "cd backend-go && gofmt -l . && go vet ./...",
    "test:go": "cd backend-go && go test ./...",
    "test:regression": "bash backend-go/scripts/regression-sweep.sh",
    "test:media": "node --experimental-strip-types --test scripts/media-regression.test.mjs",
    "test:music": "node --test scripts/music-regression.test.mjs",
    "start": "node scripts/start.js",
    "build:exe": "node scripts/build-exe.js",
    "build:backend-exe": "node scripts/build-exe.js",
    "build:all": "node build-all.js",
    "postinstall": "node scripts/prune-pkg-bloat.js",
    "dev:backend:node": "npm run dev -w backend",
    "build:node-backend": "npm run build -w backend",
    "lint:node-backend": "npm run lint -w backend",
    "test:server": "node scripts/server-regression/run.cjs"
  },
  "pkg": {
    "assets": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "backend/.env"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@yao-pkg/pkg": "^6.23.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "multer": "^2.2.0",
    "node-forge": "^1.4.0",
    "sql.js": "^1.14.1"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zero-wyc/ZViewer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Zero-wyc/ZViewer/issues"
  },
  "homepage": "https://github.com/Zero-wyc/ZViewer#readme",
  "overrides": {
    "mediabunny": "file:frontend/vendor/mediabunny"
  }
}
